  {
    "type": "appleScriptTitledButton",
    "align": "right",
    "width": 50,
    "bordered": true,
    "background": "#444444",
    "refreshInterval": 0.5,
    "source": {
      "inline": "set title to \"​\"\rset callStatus to do shell script \"curl -s -X GET 'http://localhost:3491/v1/status' -H 'accept: application/json' | jq -r '.call'\"\rset val to {title, callStatus}\rreturn val"
    },
    "alternativeImages": {
      "active": {
        "filePath": "~/Library/Application Support/MTMR/bring-to-front@2x.png"
      },
      "inactive": {
        "filePath": "~/Library/Application Support/MTMR/bring-to-front-disabled@2x.png"
      }
    },
    "action": "shellScript",
    "executablePath": "/usr/bin/curl",
    "shellArguments": [
      "-X POST",
      "-H accept: application/json",
      "http://localhost:3491/v1/bring-to-front"
    ]
  },
